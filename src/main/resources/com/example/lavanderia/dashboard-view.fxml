<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.lavanderia.controller.DashboardController"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2e7d32;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
            </padding>
            <Label fx:id="lblBienvenida" text="Bienvenido"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
            </padding>

            <Label text="Menú principal" style="-fx-font-size: 16px; -fx-text-fill: #666666;"/>

            <Button fx:id="btnOrdenes" text="Gestionar Órdenes de Lavado" onAction="#onOrdenesClick"
                    maxWidth="280.0" prefWidth="280.0" prefHeight="40.0"
                    style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
            </padding>
            <Button fx:id="btnCerrarSesion" text="Cerrar sesión" onAction="#onCerrarSesionClick"
                    style="-fx-background-color: #c62828; -fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>
