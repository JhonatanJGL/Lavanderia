<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.lavanderia.controller.LoginController"
      style="-fx-background-color: #f4f6f8;">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Lavandería" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label text="Iniciar sesión" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>

    <TextField fx:id="txtUsuario" promptText="Nombre de usuario" maxWidth="260.0"/>

    <Button fx:id="btnIngresar" text="Ingresar" onAction="#onIngresarClick"
            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"
            maxWidth="260.0" prefWidth="260.0"/>

    <Label fx:id="lblMensaje" style="-fx-text-fill: #c62828;" wrapText="true" maxWidth="260.0"/>
</VBox>
