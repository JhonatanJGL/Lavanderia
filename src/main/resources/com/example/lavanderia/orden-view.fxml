<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.lavanderia.controller.OrdenController"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2e7d32;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
            </padding>
            <Label text="Órdenes de Lavado" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="&lt;&lt; Volver al menú" onAction="#onVolverClick"
                    style="-fx-background-color: white; -fx-text-fill: #2e7d32;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
            </padding>

            <TableView fx:id="tablaOrdenes" prefHeight="260.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="140.0"/>
                    <TableColumn fx:id="colServicio" text="Servicio" prefWidth="140.0"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100.0"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80.0"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="80.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
                </columns>
            </TableView>

            <Label fx:id="lblMensaje" style="-fx-text-fill: #c62828;"/>

        </VBox>
    </center>

    <bottom>
        <VBox spacing="10.0" style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
            </padding>

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="90.0"/>
                    <ColumnConstraints minWidth="180.0"/>
                    <ColumnConstraints minWidth="90.0"/>
                    <ColumnConstraints minWidth="180.0"/>
                </columnConstraints>

                <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbCliente" promptText="Seleccione cliente" maxWidth="Infinity"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Servicio:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="cbServicio" promptText="Seleccione servicio" maxWidth="Infinity"
                          GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Fecha:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFecha" maxWidth="Infinity"
                            GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Cantidad:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="txtCantidad" promptText="Ej: 2"
                           GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Estado:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbEstado" promptText="Seleccione estado" maxWidth="Infinity"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Total:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <Label fx:id="lblTotal" text="\$0.00" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            </GridPane>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button fx:id="btnNuevo" text="Nuevo" onAction="#onNuevoClick"/>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardarClick"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizarClick"
                        style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminarClick"
                        style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
