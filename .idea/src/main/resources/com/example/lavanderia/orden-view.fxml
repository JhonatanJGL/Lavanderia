<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.lavanderia.controller.OrdenController"
            styleClass="root" stylesheets="@styles.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header-bar">
            <padding>
                <Insets bottom="18.0" left="25.0" right="25.0" top="18.0"/>
            </padding>
            <Label text="🧾 Órdenes de Lavado" styleClass="header-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="&lt;&lt; Volver al menú" onAction="#onVolverClick"
                    styleClass="btn-outline"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="15.0"/>
            </padding>

            <TableView fx:id="tablaOrdenes" prefHeight="260.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="140.0"/>
                    <TableColumn fx:id="colServicio" text="Servicio" prefWidth="140.0"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100.0"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80.0"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="80.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
                </columns>
            </TableView>

            <Label fx:id="lblMensaje" styleClass="error-label"/>

        </VBox>
    </center>

    <bottom>
        <VBox spacing="12.0" styleClass="form-panel">
            <padding>
                <Insets bottom="18.0" left="25.0" right="25.0" top="18.0"/>
            </padding>

            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="90.0"/>
                    <ColumnConstraints minWidth="190.0"/>
                    <ColumnConstraints minWidth="90.0"/>
                    <ColumnConstraints minWidth="190.0"/>
                </columnConstraints>

                <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbCliente" promptText="Seleccione cliente" maxWidth="Infinity"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Servicio:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="cbServicio" promptText="Seleccione servicio" maxWidth="Infinity"
                          GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Fecha:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFecha" maxWidth="Infinity"
                            GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Cantidad:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="txtCantidad" promptText="Ej: 2"
                           GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Estado:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbEstado" promptText="Seleccione estado" maxWidth="Infinity"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Total:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <Label fx:id="lblTotal" text="\$0.00" styleClass="total-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            </GridPane>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button fx:id="btnNuevo" text="Nuevo" onAction="#onNuevoClick" styleClass="btn-secondary"/>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardarClick" styleClass="btn-primary"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizarClick" styleClass="btn-info"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminarClick" styleClass="btn-danger"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
